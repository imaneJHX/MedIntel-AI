# Optional local development settings. Copy to .env only if overrides are needed.
# No real credentials belong here. The API has no authentication in Phase 5.
MEDINTEL_PROJECT_ROOT=C:/MedIntel-AI
MEDINTEL_CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:3000","http://127.0.0.1:3000"]
MEDINTEL_CORS_ALLOW_CREDENTIALS=false
MEDINTEL_MAX_REQUEST_BYTES=16384
# Reports have a separate limit; inference JSON limits remain unchanged.
MEDINTEL_REPORT_MAX_BYTES=5242880
MEDINTEL_REPORT_MAX_PAGES=5
MEDINTEL_REPORT_TIMEOUT_SECONDS=40
MEDINTEL_REPORT_OCR_TIMEOUT_SECONDS=8
# Optional absolute executable path after installing local Tesseract + English data.
MEDINTEL_TESSERACT_COMMAND=
