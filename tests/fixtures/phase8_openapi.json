  "components": {
    "schemas": {
      "CategoryOption": {
        "properties": {
          "value": {
            "type": "integer",
            "title": "Value"
          },
          "label": {
            "type": "string",
            "title": "Label"
          }
        },
        "type": "object",
        "required": [
          "value",
          "label"
        ],
        "title": "CategoryOption"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "code": {
            "type": "string",
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "field",
          "code",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "Explanation": {
        "properties": {
          "units": {
            "type": "string",
            "const": "positive-class log-odds",
            "title": "Units"
          },
          "baseline_log_odds": {
            "type": "number",
            "title": "Baseline Log Odds"
          },
          "model_output_log_odds": {
            "type": "number",
            "title": "Model Output Log Odds"
          },
          "reconstructed_log_odds": {
            "type": "number",
            "title": "Reconstructed Log Odds"
          },
          "max_reconstruction_error": {
            "type": "number",
            "title": "Max Reconstruction Error"
          },
          "background_records": {
            "type": "integer",
            "title": "Background Records"
          },
          "input_values": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Input Values"
          },
          "feature_contributions": {
            "items": {
              "$ref": "#/components/schemas/FeatureContribution"
            },
            "type": "array",
            "title": "Feature Contributions"
          },
          "top_positive_contributors": {
            "items": {
              "$ref": "#/components/schemas/FeatureContribution"
            },
            "type": "array",
            "title": "Top Positive Contributors"
          },
          "top_negative_contributors": {
            "items": {
              "$ref": "#/components/schemas/FeatureContribution"
            },
            "type": "array",
            "title": "Top Negative Contributors"
          },
          "interpretation": {
            "type": "string",
            "title": "Interpretation"
          }
        },
        "type": "object",
        "required": [
          "units",
          "baseline_log_odds",
          "model_output_log_odds",
          "reconstructed_log_odds",
          "max_reconstruction_error",
          "background_records",
          "input_values",
          "feature_contributions",
          "top_positive_contributors",
          "top_negative_contributors",
          "interpretation"
        ],
        "title": "Explanation"
      },
      "ExplanationResponse": {
        "properties": {
          "model": {
            "type": "string",
            "const": "heart-disease-logistic-regression",
            "title": "Model",
            "default": "heart-disease-logistic-regression"
          },
          "prediction": {
            "$ref": "#/components/schemas/Prediction"
          },
          "disclaimer": {
            "type": "string",
            "title": "Disclaimer",
            "default": "Experimental research output. Not a medical diagnosis or clinically calibrated risk estimate."
          },
          "explanation": {
            "$ref": "#/components/schemas/Explanation"
          }
        },
        "type": "object",
        "required": [
          "prediction",
          "explanation"
        ],
        "title": "ExplanationResponse"
      },
      "FeatureContribution": {
        "properties": {
          "feature": {
            "type": "string",
            "title": "Feature"
          },
          "original_feature": {
            "type": "string",
            "title": "Original Feature"
          },
          "category": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Category"
          },
          "transformed_value": {
            "type": "number",
            "title": "Transformed Value"
          },
          "contribution_log_odds": {
            "type": "number",
            "title": "Contribution Log Odds"
          }
        },
        "type": "object",
        "required": [
          "feature",
          "original_feature",
          "category",
          "transformed_value",
          "contribution_log_odds"
        ],
        "title": "FeatureContribution"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          },
          "service": {
            "type": "string",
            "const": "MedIntel AI",
            "title": "Service",
            "default": "MedIntel AI"
          },
          "version": {
            "type": "string",
            "const": "1.0.0",
            "title": "Version",
            "default": "1.0.0"
          }
        },
        "type": "object",
        "title": "HealthResponse"
      },
      "HeartRecord": {
        "properties": {
          "age": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 77.0,
                "minimum": 29.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Age",
            "description": "Age at observation.",
            "nullable": true,
            "range_semantics": "Observed training support; not medical normality.",
            "unit": "years"
          },
          "sex": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "enum": [
              0,
              1,
              null
            ],
            "title": "Recorded sex",
            "description": "Sex coding in the historical UCI source.",
            "nullable": true
          },
          "cp": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "enum": [
              1,
              2,
              3,
              4,
              null
            ],
            "title": "Chest-pain type",
            "description": "Original UCI chest-pain category.",
            "nullable": true
          },
          "trestbps": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 200.0,
                "minimum": 94.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Resting blood pressure",
            "description": "Resting blood pressure recorded on hospital admission.",
            "nullable": true,
            "range_semantics": "Observed training support; not medical normality.",
            "unit": "mm Hg"
          },
          "chol": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 564.0,
                "minimum": 126.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Serum cholesterol",
            "description": "Recorded serum cholesterol.",
            "nullable": true,
            "range_semantics": "Observed training support; not medical normality.",
            "unit": "mg/dL"
          },
          "fbs": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "enum": [
              0,
              1,
              null
            ],
            "title": "Fasting blood sugar indicator",
            "description": "Dataset indicator for fasting blood sugar above 120 mg/dL; this is a source definition, not a recommendation.",
            "nullable": true
          },
          "restecg": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "enum": [
              0,
              1,
              2,
              null
            ],
            "title": "Resting ECG",
            "description": "Original resting ECG result code.",
            "nullable": true
          },
          "thalach": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 202.0,
                "minimum": 71.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Maximum heart rate",
            "description": "Maximum heart rate achieved.",
            "nullable": true,
            "range_semantics": "Observed training support; not medical normality.",
            "unit": "beats/min"
          },
          "exang": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "enum": [
              0,
              1,
              null
            ],
            "title": "Exercise-induced angina",
            "description": "Recorded exercise-angina indicator.",
            "nullable": true
          },
          "oldpeak": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 6.2,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Exercise ST depression",
            "description": "ST depression relative to rest; the UCI field documentation does not specify units.",
            "nullable": true,
            "range_semantics": "Observed training support; not medical normality."
          },
          "slope": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "enum": [
              1,
              2,
              3,
              null
