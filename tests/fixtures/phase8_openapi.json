    "/api/v1/reports/extract": {
      "post": {
        "tags": [
          "Synthetic medical reports"
        ],
        "summary": "Extract a synthetic laboratory report for manual transcription review",
        "operationId": "extract_report_api_v1_reports_extract_post",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "properties": {
                  "file": {
                    "type": "string",
                    "format": "binary"
                  },
                  "synthetic_only": {
                    "type": "boolean",
                    "description": "Must be true; no real personal or patient information."
                  }
                },
                "type": "object",
                "required": [
                  "file",
                  "synthetic_only"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
