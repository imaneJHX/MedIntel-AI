# Local Python environments
.venv/
venv/
env/

# Python bytecode and caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/

# Test coverage and build output
.coverage
.coverage.*
htmlcov/
build/
dist/
*.egg-info/

# Local datasets (may contain sensitive healthcare information)
/data/raw/*
!/data/raw/.gitkeep
/data/processed/*
!/data/processed/.gitkeep

# Local secrets and credentials
.env
.env.*
!.env.example
/secrets/
/credentials/
*.pem
*.key

# Saved models and generated model artifacts
/models/*
!/models/.gitkeep
*.pkl
*.pickle
*.joblib
*.onnx
*.h5
*.hdf5
*.pt
*.pth
*.keras
*.ckpt

# Generated experiment reports and plots; notebook outputs remain reviewable
/reports/metrics/*
!/reports/metrics/.gitkeep
/reports/figures/*
!/reports/figures/.gitkeep

# OS metadata
.DS_Store
Thumbs.db

# Frontend dependencies and generated checks
node_modules/
coverage/
playwright-report/
test-results/
*.tsbuildinfo
*.local.json
